<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- App version ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â keep in sync with /version.json (see CLAUDE.md versioning rule). -->
    <Version>0.245.3</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.100.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageReference Include="Ical.Net" Version="5.2.3" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <!-- Rescales screenshots for vision-model chat attachments (VisionImageEncoder). MIT over Google's
         BSD Skia - chosen over ImageSharp, whose Six Labors Split License needs a commercial licence for
         anything but OSS and small companies. The NoDependencies native asset carries its own
         libSkiaSharp.so and needs no fontconfig, so the runtime Dockerfile stays untouched (we resample
         pixels and never render text). -->
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" />
    <!-- Pin a patched System.IO.Packaging (OpenXml pulls a transitive 8.0.0 with a high-severity advisory). -->
    <PackageReference Include="System.IO.Packaging" Version="10.0.10" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <!-- Official MCP C# SDK ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â hosts the in-process Streamable-HTTP /mcp endpoint (tools/resources/prompts). -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
    <!-- Direct pin to override the transitive Microsoft.OpenApi 2.0.0 (from AspNetCore.OpenApi), which has
         a high-severity advisory GHSA-v5pm-xwqc-g5wc (stack overflow on circular schema refs). 2.7.5 is the
         first patched release on the 2.x line.

         The RANGE, not just a floor: 3.x MUST NOT be taken while this project targets ASP.NET Core 10.
         Microsoft.OpenApi 3.0 made the object model read-only by interface (IOpenApiSchema,
         IOpenApiMediaType and friends lost their setters), but ASP.NET Core 10's OpenAPI source
         generator still emits `mediaType.Example = ...` - so the generated file simply does not
         compile: "CS0200: Property or indexer 'IOpenApiMediaType.Example' cannot be assigned to".
         Upstream is explicit that AspNetCore.OpenApi 10.x requires the 2.x line
         (microsoft/OpenAPI.NET#2610); the alignment is filed as an ASP.NET Core *11* breaking change.

         A bare `Version="2.7.5"` is only a MINIMUM in NuGet, and AspNetCore.OpenApi declares its own
         dependency as an open-ended `[2.0.0, )` with no upper bound despite being incompatible - which
         is why a routine dependency bump proposed 3.9.0 and broke every .NET job. The explicit ceiling
         is what stops that, here, where it is enforced rather than in a bot's ignore list.

         REMOVE THE CEILING when this project moves to ASP.NET Core 11 - and expect work in
         OpenApi/OpenApiCuration.cs at the same time, since its transformers mutate the document
         (`document.Components.SecuritySchemes ??= ...`) rather than only inspecting it. -->
    <PackageReference Include="Microsoft.OpenApi" Version="[2.7.5,3.0.0)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
    <!-- OpenIddict OAuth 2.1 / OpenID Connect server + validation + ASP.NET Core host: makes the API an
         authorization server + resource server for the MCP web connector (claude.ai). EntityFrameworkCore
         supplies the store wiring for AddCore().UseEntityFrameworkCore(). Pinned exactly (security-critical). -->
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.5.0" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.5.0" />
    <!-- Error + performance reporting to a Sentry-compatible endpoint (GlitchTip); see TelemetryOptions. -->
    <PackageReference Include="Sentry.AspNetCore" Version="6.8.0" />
    <PackageReference Include="StackExchange.Redis" Version="3.0.0" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Diariz.Domain\Diariz.Domain.csproj" />
  </ItemGroup>

  <!-- Server-side export/email string catalogs, read at runtime by JsonExportLocalizer. Copied next to
       the app so they ship in the published image (and can be edited/mounted without a rebuild). -->
  <ItemGroup>
    <Content Update="locales\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Editable LLM prompt templates, read at runtime (edit/mount without a rebuild). -->
  <ItemGroup>
    <Content Include="prompts\**\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Editable Diariz-provided formulas, read at boot (edit/mount/extend without a rebuild). -->
  <ItemGroup>
    <Content Include="formulas\**\*.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- The standard minutes templates, same format. -->
    <Content Include="meeting-types\**\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
