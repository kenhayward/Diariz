  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "Capture is client-side; the API is contacted once, at Stop",
        "POST /api/recordings stores the blob and enqueues a job",
        "The API drains 8 of the 11 Redis streams in-process",
        "SignalR RecordingStatusChanged pushes status to the browser"
      ]
    },
    {
      "dot": "violet",
      "title": "Data and storage",
      "items": [
        "Segment embeddings vector(768), voiceprints vector(192)",
        "Transcriptions are versioned per recording; renames survive",
        "Summaries, minutes, actions, tags and formulas are LLM-written",
        "MinIO holds original audio and uploaded attachments"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries and egress",
      "items": [
        "nginx is the only published surface; Redis and MinIO are not",
        "Every user-scoped query filters by the JWT NameIdentifier claim",
        "Worker callbacks authenticate with X-Worker-Secret, not JWT",
        "Optional egress: Google/Outlook calendars, SMTP, GlitchTip"
      ]
    }
  ]
