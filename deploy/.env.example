# Copy to .env and fill in. Never commit the real .env.

# Postgres
POSTGRES_PASSWORD=diariz
# Host port + bind address for external DB access (psql / pgAdmin / test harnesses). 5433 avoids clashing
# with a Postgres already listening on the host's 5432. POSTGRES_BIND=127.0.0.1 keeps it host-only (tunnel
# over SSH to reach it); the default 0.0.0.0 makes it LAN-reachable and bypasses the host firewall, so set
# a strong POSTGRES_PASSWORD above before leaving it open. Connect with:
#   psql -h <server> -p 5433 -U diariz -d diariz
POSTGRES_PORT=5433
POSTGRES_BIND=0.0.0.0

# MinIO (object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio

# JWT signing key — must be at least 32 characters
JWT_KEY=replace-with-a-long-random-secret-at-least-32-chars

# Shared secret the worker uses on the internal callback endpoint
CALLBACK_SECRET=change-me-worker-secret

# Seed user (the Platform Administrator) created on first startup
SEED_EMAIL=admin@example.com
SEED_PASSWORD=ChangeMe123!
SEED_FULL_NAME=Platform Administrator

# Public browser URL, used to build the account-setup link in emails (the web origin, not the API). Also the
# OAuth token issuer for the MCP web connector - it must be the public HTTPS origin in production.
APP_PUBLIC_URL=http://localhost:8081

# OAuth 2.1 sign-in for the claude.ai web MCP connector (built on OpenIddict). On by default; signing keys
# persist to the same /keys volume as the Data Protection keyring. Set to false to disable the OAuth server
# (the static dz_mcp_ personal token for Claude Desktop/Code is unaffected either way).
MCP_OAUTH_ENABLED=true

# Google sign-in (optional). Create a "Web application" OAuth client in Google Cloud Console and set the
# authorized redirect URI to {APP_PUBLIC_URL}/api/auth/google/callback. Leave the id/secret empty to disable
# Google sign-in (the login page then hides the button). GOOGLE_REDIRECT_URI is optional — when blank it is
# derived from APP_PUBLIC_URL. Never commit the real secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# SMTP for the account-setup email. Leave SMTP_HOST empty to disable email — the grant screen then
# shows the one-time setup link for an admin to share manually.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_STARTTLS=true

# Hugging Face token for pyannote diarization (gated models — accept their terms first)
HF_TOKEN=

# Worker compute (defaults target GPU). For CPU-only: WORKER_DEVICE=cpu, WORKER_COMPUTE_TYPE=int8
WORKER_DEVICE=cuda
WORKER_COMPUTE_TYPE=float16
WHISPER_MODEL=large-v3
# (The Whisper ASR backend is not set here — it's intrinsic to the compose file you run: the NVIDIA stack
# uses faster-whisper/CTranslate2, the AMD stack [docker-compose.rocm.yml] hardcodes openai-whisper. So this
# one .env is safe for both. See src/Diariz.Worker/README.md → AMD ROCm.)
# AMD ROCm only: gfx-arch override for the worker GPU. Leave blank when your ROCm build supports your card
# natively; set it if model load fails with "no kernel image" (e.g. 11.0.0 = gfx1100 kernels, a common
# Strix Halo / gfx1151 fallback). Ignored by the NVIDIA stack.
HSA_OVERRIDE_GFX_VERSION=
# WhisperX transcription batch size. Lower it (e.g. 8 or 4) to reduce peak VRAM on smaller GPUs
# (see src/Diariz.Worker/README.md → GPU and hardware requirements).
BATCH_SIZE=16
# Reject uploaded/recorded audio longer than this many seconds (0 = unlimited). 14400 = 4 h.
MAX_AUDIO_SECONDS=14400

# Uploaded audio files (the "Upload" button). Server validates the actual bytes (magic-byte sniff).
# UPLOAD_MAX_BYTES caps a single file (524288000 = 500 MB). UPLOAD_ALLOW_AAC=false drops M4A/AAC
# (which has active patents) for maximum commercial caution; royalty-free formats are always accepted.
UPLOAD_MAX_BYTES=524288000
UPLOAD_ALLOW_AAC=true

# Speaker identification (enrolled voiceprints). The worker extracts a per-speaker ECAPA
# embedding; the API auto-matches it against the owner's enrolled people within Threshold
# (max cosine distance — conservative default, tune for your audio). Set ENABLE_SPEAKER_EMBEDDINGS=0
# to skip embedding extraction entirely.
ENABLE_SPEAKER_EMBEDDINGS=1
IDENTIFICATION_ENABLED=true
IDENTIFICATION_THRESHOLD=0.4

# LLM summarisation (OpenAI-compatible endpoint). Leave SUMMARY_API_BASE empty to disable the
# Summarise button. Works with OpenAI, a local server (Ollama/LM Studio/vLLM), etc.
#   e.g. SUMMARY_API_BASE=https://api.openai.com/v1  or  http://host.docker.internal:1234/v1
SUMMARY_API_BASE=
SUMMARY_API_KEY=
SUMMARY_MODEL=gpt-4o-mini
# Reasoning models: send an OpenAI-style reasoning_effort on LLM requests. Off by default (many
# endpoints reject it); each user can override this in Settings → Model Settings. Level: low | medium | high.
SUMMARY_REASONING_ENABLED=false
SUMMARY_REASONING_EFFORT=medium

# Chat voice dictation (optional) - OpenAI-compatible speech-to-text endpoint for the server-fallback
# dictation path (desktop app / Safari / Firefox). Empty DICTATION_API_BASE disables it; the browser
# SpeechRecognition path still works in Chrome/Edge.
DICTATION_API_BASE=
DICTATION_API_KEY=
DICTATION_MODEL=whisper-1
DICTATION_TIMEOUT_SECONDS=30

# Semantic search (RAG) embeddings. Leave EMBED_API_BASE empty to reuse the summarisation endpoint
# (self-hosters usually run one server serving both); empty everywhere disables semantic search and
# transcript search stays lexical. The model + dimension are SERVER-PINNED - every chunk and query must
# use the same model, and EMBED_DIMENSION must equal the vector column (768). Changing the model means a
# re-embed + a schema migration. Works with Ollama (nomic-embed-text), OpenAI (text-embedding-3-small,
# set dimension to 768 via the model), a local server, etc.
#   e.g. EMBED_API_BASE=http://host.docker.internal:11434/v1  EMBED_MODEL=nomic-embed-text
EMBED_API_BASE=
EMBED_API_KEY=
EMBED_MODEL=nomic-embed-text
EMBED_DIMENSION=768
# The nomic models are trained with these task prefixes and retrieve better with them. Leave as-is for
# nomic; set BOTH empty for models that don't use prefixes (e.g. OpenAI text-embedding-3-*). Query and
# document sides must stay paired. Changing them means re-indexing (re-transcribe or the startup backfill).
EMBED_QUERY_PREFIX="search_query: "
EMBED_DOCUMENT_PREFIX="search_document: "

# Model context window in tokens. Despite the CHAT_ prefix (kept so existing deployments don't break)
# this is the PLATFORM-WIDE window: it drives the chat context dial AND the single context budget every
# LLM call uses - recording summaries, meeting minutes, folder summary/minutes roll-ups, formula runs
# and chat alike. 60% of it is spent on injected context; the rest is left for the prompt template and
# the model's own reply. Set it to your model's real window - too high and requests get rejected or
# truncated by the endpoint, too low and folder roll-ups start omitting meetings. Per-user overridable
# in Settings (the "chat context window" field).
CHAT_CONTEXT_LENGTH=131072
# Chat tool calling (built-in transcript tools). Off by default — needs a model that supports OpenAI
# tool calling. CHAT_DISABLED_TOOLS is a comma-separated list of tool names off by default server-wide
# (every other registered tool is on). Both are overridable per-user in Settings.
CHAT_TOOLS_ENABLED=false
CHAT_DISABLED_TOOLS=

# ---- Observability (optional): self-hosted GlitchTip error tracking + timings ----
# Enabled only when you run the overlay:
#   docker compose -f docker-compose.yml -f docker-compose.observability.yml up -d
# Leaving SENTRY_DSN / Sentry__Dsn empty keeps the worker and API completely uninstrumented.

# Full external URL INCLUDING the scheme. Django derives its CSRF trusted origins from it; get this
# wrong and every login fails with a misleading "wrong password".
GLITCHTIP_DOMAIN=https://errors.dev.example.com
GLITCHTIP_SECRET_KEY=
GLITCHTIP_POSTGRES_PASSWORD=
# Host port for the outer reverse proxy. Keep the bind on 127.0.0.1 unless the proxy is off-box.
# If the proxy IS off-box, either pin this host's private address (narrowest, but a fixed IP hidden
# in .env that breaks on re-addressing) or leave it 0.0.0.0 and restrict to the proxy at the network
# layer (visible to whoever runs the network - usually the better fit when someone else does).
# Either way: Docker's published ports are DNAT rules that BYPASS the host firewall, so a firewall
# rule for this port does nothing. See "Topology" in docs/GlitchTip_Deployment.md.
GLITCHTIP_PORT=8000
GLITCHTIP_BIND=127.0.0.1

# Optional. Unset means the permissive wildcard. If you set it, you MUST include `glitchtip` as well
# as the public hostname - the API and worker post in-network as `Host: glitchtip`, and Django drops
# any host not listed, which silently stops server-side reporting.
# Example: errors.dev.diariz.example.com,glitchtip
GLITCHTIP_ALLOWED_HOSTS=

# GlitchTip's own SMTP credentials, deliberately separate from the app's EMAIL__* settings so a
# technical-contact address can diverge from the app's sender without one change breaking the other.
# Format: smtp+tls://user:password@host:port  (port 465 instead uses smtp+ssl://)
#
# The SCHEME sets the encryption mode and is not optional: only `smtp+tls`/`smtps` turn on STARTTLS
# and only `smtp+ssl` turns on implicit TLS. A plain `smtp://` connects in clear text, and since
# servers only advertise AUTH once the connection is secured, sign-up and password-reset mail dies
# with "SMTP AUTH extension not supported by server" - which reads like the server's fault.
GLITCHTIP_EMAIL_URL=
GLITCHTIP_FROM_EMAIL=

# DuckDB cold storage (Parquet) in MinIO. MUST be its OWN bucket, never a prefix inside `recordings`:
# a platform restore wipes the recordings bucket and would silently destroy the telemetry archive.
# Use a scoped MinIO key, NOT the root credentials - root would give an observability tool full
# read/write access to every user's audio.
GLITCHTIP_COLD_STORAGE_BUCKET=glitchtip
GLITCHTIP_MINIO_ACCESS_KEY=
GLITCHTIP_MINIO_SECRET_KEY=

# DSNs issued by the GlitchTip UI after creating the projects. Empty = that runtime reports nothing.
SENTRY_DSN=
SENTRY_API_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# Browser DSN for the SPA, served at runtime via GET /api/config. Create this as a SEPARATE GlitchTip
# project from the API and worker: browser errors are far noisier (extensions, old tabs, flaky
# networks) and would otherwise bury server-side failures.
SENTRY_BROWSER_DSN=

# Source map upload (optional). The web image is built on this server (apps/web/Dockerfile), never in
# CI, so this is where it has to happen - and it is wired straight into the normal
# `docker compose up --build` flow (docker-compose.yml's web service), no extra flags needed. Without
# these the image still builds; the SPA just ships "hidden" source maps (generated, never served - see
# vite.config.ts) and production stack traces stay minified. All four of URL/org/project/token are
# required for the upload to run; missing any one of them just skips it with a log line, and a failed
# upload (bad token, unreachable server) warns rather than failing the build. Org and project are slugs
# from the GlitchTip UI - project must be the SAME browser project as SENTRY_BROWSER_DSN above, or
# GlitchTip will not attach the maps to incoming events. Uses @glitchtip/cli
# (`npx @glitchtip/cli sourcemaps inject` then `... sourcemaps upload`).
#
# GLITCHTIP_URL must be reachable FROM INSIDE THE BUILD CONTAINER, so give it the PUBLIC domain
# (the same value as GLITCHTIP_DOMAIN above), e.g. https://errors.dev.example.com. With the default
# GLITCHTIP_BIND=127.0.0.1 the loopback port is the HOST's loopback, not the build container's -
# `http://127.0.0.1:8000` or `http://localhost:8000` here connects to nothing and the upload warns
# "connection refused" while the build still succeeds, so the failure is easy to miss. Container
# service names (`http://glitchtip:8000`) do not work either: the build runs before, and outside, the
# compose network.
GLITCHTIP_URL=
GLITCHTIP_ORG=
GLITCHTIP_PROJECT=
# Auth Token from GlitchTip user settings (never the DSN). Read into the build as a BuildKit secret via
# docker-compose.yml's `secrets: glitchtip_token: { environment: GLITCHTIP_TOKEN }` - never a build ARG,
# since an ARG is recorded in the image history and readable by anyone who can pull the image. Setting
# it here is enough; `docker compose up --build` picks it up automatically.
GLITCHTIP_TOKEN=
# Optional override for the release tag the uploaded maps are stamped with (__APP_VERSION__ in the
# bundle). Leave blank - apps/web/Dockerfile then falls back to apps/web/package.json's version, which
# is what the bundle itself falls back to at build time, so the two stay in agreement either way.
APP_VERSION=
